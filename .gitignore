# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# user-provided source files (optimized copies live under public/images)
GELEN_ICERIKLER/**/*.docx
GELEN_ICERIKLER/**/*.pdf
GELEN_ICERIKLER/**/*.png
GELEN_ICERIKLER/**/*.jpg
GELEN_ICERIKLER/**/*.jpeg
GELEN_ICERIKLER/**/*.webp
GELEN_ICERIKLER/**/*.xlsx
GELEN_ICERIKLER/**/*.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
